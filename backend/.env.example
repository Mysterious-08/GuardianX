APP_NAME=GuardianX
APP_VERSION=1.0.0
DEBUG=False
SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///./guardianx.db
# Semicolon-separated absolute paths allowed for backup sources, snapshots, and recovery output.
# Leave empty to keep filesystem backup operations disabled until roots are configured.
BACKUP_ALLOWED_ROOTS=
# Optional. If empty, restore selects the only allowed root separate from source and backup.
RECOVERY_ROOT=
# Scheduled backups are disabled unless explicitly enabled.
BACKUP_SCHEDULER_ENABLED=false
BACKUP_INTERVAL_MINUTES=60
BACKUP_SOURCE_DIRECTORY=
BACKUP_DESTINATION_DIRECTORY=
# Registered agent UUID whose owner receives scheduled snapshots.
BACKUP_DEVICE_AGENT_ID=
